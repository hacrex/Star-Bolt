# Configure these as Supabase Edge Function secrets, never as VITE_* variables.
# The public site remains truthful and shows an unconfigured state when these are absent.
YOUTUBE_API_KEY=
YOUTUBE_SYNC_SECRET=
YOUTUBE_CHANNEL_HANDLE=@starlyrix
# Prefer a curated playlist or an explicit allowlist for Star Lyrix Shorts.
YOUTUBE_SHORTS_PLAYLIST_ID=
YOUTUBE_SHORTS_VIDEO_IDS=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
MUSIXMATCH_PRO_API_KEY=
# Use the licensed Musixmatch Pro endpoint contract provided for your account.
# Replace {value} with an encoded query or track identifier.
MUSIXMATCH_PRO_SEARCH_ENDPOINT=
MUSIXMATCH_PRO_LYRICS_ENDPOINT=
